{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ - Rally %lld" : {
      "comment" : "Name of a favorited rally clip; %1$@ is the source video name, %2$lld the rally number",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ - Rally %2$lld"
