          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ color: %2$@"
          }
        }
      }
    },
    "%@ commented on your rally" : {
      "comment" : "Notification row; %@ is the username"
    },
    "%@ couldn't keep running in the background. Your progress is saved — open BumpSetCut and start it again to continue." : {
